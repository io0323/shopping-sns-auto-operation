# 楽天ウェブサービス
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
# 楽天APIのアクセスキー(未設定だと 400 accessKey must be present が返る)
RAKUTEN_ACCESS_KEY=
RAKUTEN_REFERER=

# Anthropic
ANTHROPIC_API_KEY=

# コスト上限(円/月)
MONTHLY_LLM_BUDGET_JPY=3000

# DB(SQLAlchemy接続文字列)
DATABASE_URL=sqlite:///./data.db

# 役割別モデル(ハードコード禁止。ここで切替)
MODEL_GENERATOR=claude-sonnet-5
MODEL_EVALUATOR=claude-haiku-4-5
MODEL_LEARNING=claude-sonnet-5

# コスト概算用の為替レート(USD->JPY)
USD_JPY_RATE=150.0

# パイプライン通知用Slack Webhook(任意。未設定なら送信しない)
SLACK_WEBHOOK_URL=

# CORS許可オリジン(カンマ区切り)。未設定なら http://localhost:3000 のみ許可。
# フロントを別ポートで起動する場合(3000が専有されている等)はここに追記する。
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
